// A meta language. Which I will use on next language Block Set.

def 程序 {  // 程序 = program
    def语句 (N >= 0);  // def语句 = def-statement
};

def 名 {  // 名 = name
    (英文字母; / 汉字;) (N = 1);  // 英文字母 = ASCII letter; 汉字 = Chinese character
    (英文字母; / 汉字; / 数字; / "_";) (N >= 0);  // 数字 = digit
} not {
    "def"; / "not"; / "N"; / "nospace";
};

// nospace是一个断言，若匹配到空格则判定匹配失败。
// nospace is an assertion; if whitespace is matched, the assertion fails.

def def语句 {  // def语句 = def-statement
    "def"; 名; "{"; 式 (N = [0,1]); "}";  // 式 = expression
    ("not"; "{"; 式; "}";) (N = [0,1]);
    ";";
};

// not 块：前面的匹配完成后，对同一段 TOKEN 流执行 not 块中的式。
// not block: after the preceding match completes, the expression inside the not block
// is executed against the same segment of the token stream.
// 如果 not 块无遗漏地匹配成功，则前面那次匹配视为失败。
// If the not block matches completely and exhaustively, the preceding match is considered a failure.

def 式 {  // 式 = expression
    语句 (N >= 1);  // 语句 = statement
    ("/"; 语句 (N >= 1);) (N >= 0);
};

// / 表示有序分支
// / denotes ordered choice

def 语句 {  // 语句 = statement
    (
        名;
        / "\""; 任意字符; "\"";  // 任意字符 = any character
        / 圆括号块;  // 圆括号块 = parenthesized block
    );
    条件 (N = [0,1]);  // 条件 = condition
    / "nospace";
    ";";
};

def 圆括号块 {  // 圆括号块 = parenthesized block
    "("; 式 (N >= 1); ")";
};

def 条件项 {  // 条件项 = condition item
    "N";
    (
        (">"; / "<"; / ">="; / "<=";); 数字;  // 数字 = number
        / "="; (
            数字;
            / "["; 数字 (N >= 1); (","; 数字;) (N >= 0); "]";
        );
    );
};

def 条件 {  // 条件 = condition
    "("; 条件项; (","; 条件项;) (N >= 0); ")";
};

def 注释 {  // 注释 = comment
    "/*"; 任意字符 (N >= 0); "*/";
    / "//"; 任意字符 (N >= 0); 换行;  // 换行 = newline
};

// 贪婪匹配：重复操作默认尽可能多地匹配。
// Greedy matching: repetition operators match as much as possible by default.
// 后向断言检查下一个 TOKEN——如果下一个 TOKEN 能开启当前块的后续部分，
// A lookahead assertion checks the next token — if the next token can begin
// 则结束贪婪并继续。
// the remainder of the current block, greedy matching stops and parsing continues.
